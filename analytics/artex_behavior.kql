//     or RequestUri endswith "/v1/messages"
//     or RequestUri endswith "/v1/responses"
//     or RequestUri endswith "/api/chat"
//     or RequestUri endswith "/api/generate"
//   | where (provider_host and (provider_api or RequestContentType contains "json"))
//     or (local_api and RequestContentType contains "json" and not(RequestClientApplication startswith "Mozilla/"))
//   | project SourceIP, LlmT = TimeGenerated;
// let Bursts = Anon | summarize n = count() by cIP, B = bin(TimeGenerated, 10s) | where n >= 30;
// LLMCalls | join kind=inner Bursts on $left.SourceIP == $right.cIP
// | where B between (LlmT .. LlmT + 5m) | summarize bursts = count(), first_burst = min(B) by SourceIP
