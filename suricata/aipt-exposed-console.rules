# AIPT - detection pack for LLM-driven autonomous pentest tools
# File:       aipt-exposed-console.rules - Exposed consoles and tool APIs: ARTEX, CyberStrikeAI, HexStrike-AI, PentAGI, MetasploitMCP, MCP
# Version:    1.0.0 (2026-10-12)
# License:    Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
# Engine:     Suricata 7.0 / 8.0 (validated with suricata -T and offline -r replay on 8.0.7)
# Message:    "AIPT <tool> <what>"; generic shapes use <tool> = Generic or Scanner.
# Metadata:   affected_product, attack_target, confidence, created_at, deployment, performance_impact, policy,
#             signature_severity, tag ai_pentest,
#             updated_at (Emerging Threats Open layout). Each rule is preceded by one comment line with its source
#             (upstream file:line at the commit in README.md, or the lab capture that established it).
# Policy:     metadata "policy block-eligible|alert|informational" (measured false-positive profile in
#             docs/fp-report.md). Every action stays alert. Only block-eligible sids (listed in
#             suricata/aipt-block-eligible.sids) are candidates for drop, per sensor, after the observe-mode baseline
#             and review of DEPLOYMENT.md.
# SID ranges: 9500001-9500099 ARTEX, 9500100-9500199 earlier comparison rules, 9500200-9500299 AI-pentest family
#             (CyberStrikeAI 9500200-9500219, HexStrike-AI 9500220-9500229, PentAGI 9500230-9500239, Strix 9500240-9500249,
#             Shannon 9500250-9500259, Villager 9500260-9500264, MetasploitMCP 9500265-9500279, generic MCP 9500280-9500289,
#             scanner shapes 9500290-9500299). Retired sids are listed in retired.rules and never reused.
# Deployment (one file per sensor position; load only what the sensor can see):
#   aipt-target-facing.rules    IDS in front of your own web servers (perimeter or reverse-proxy mirror): tool and
#                               scanner fingerprints in requests sent to your applications.
#   aipt-exposed-console.rules  datacenter / hosting / internal sensors that may see an operator console or tool API
#                               (ARTEX, CyberStrikeAI, HexStrike-AI, PentAGI, MetasploitMCP, MCP servers).
#   aipt-operator-egress.rules  egress sensors of networks where an operator could run one of these tools (update
#                               checks, vendor APIs, image pulls). Most of these services are HTTPS-only: the http
#                               rules need a TLS-inspecting proxy, the tls rules use SNI/certificates.
#   aipt-llm-side.rules         only where LLM API traffic is cleartext: TLS-terminating egress proxy, LLM relay or
#                               gateway, the provider, or a local model server (Ollama/vLLM). Needs large request
#                               body limits (see that file).
#   threshold.config: approved-assessment-suppress.threshold.template (generic sids only).
#
# Direction: response-side rules (to_client) fingerprint the SERVER and set an xbit on the client/server IP pair
# (track ip_pair, 1 h). Client-side path rules that would otherwise also match scanner templates aimed at ordinary
# servers (cross-direction false positives seen in an earlier local-model CyberStrikeAI lab run) only alert when that xbit is set, i.e. after the server
# has been proven to be the tool's console. Load the whole file on one sensor; xbits do not cross sensors.
# Only product-identifying responses set the state: 9500050 (status 200 and the health JSON
# with service artex), 9500053 (status 200 and the exact console <title> tag) and 9500060 (UI asset MD5). 9500051
# (the auth-status body carries no product name) no longer sets it; it alerts only for an already identified pair.
# xbits limitations: track ip_pair is keyed on the two IP addresses only, not on host name or port, so every virtual
# host and every port between the same two addresses shares the state (a console on one vhost marks the others); a
# setter on one flow and a consumer on another flow can be processed by different threads, so a consumer that arrives
# within milliseconds of the setter may be evaluated before the state is visible; and a consumer seen before any
# setter (sensor started mid-session, asymmetric capture) never alerts.

# ---- ARTEX control plane (default :8787, plain HTTP) ----
# source: server/server.go:947-949 (unauthenticated GET /api/health body)
alert http $HOME_NET any -> any any (msg:"AIPT ARTEX Control Plane Health Response (service artex)"; flow:established,to_client; target:src_ip; http.stat_code; content:"200"; http.response_body; content:"|22|artex|22|"; fast_pattern; pcre:"/\x22service\x22\s*:\s*\x22artex\x22/"; pcre:"/\x22ok\x22\s*:\s*true/"; xbits:set,aipt.artex.console,track ip_pair,expire 3600; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500050; rev:5; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: server/auth.go:144-155 (unauthenticated GET /api/auth/status, compact JSON with only the initialized flag)
alert http $HOME_NET any -> any any (msg:"AIPT ARTEX Control Plane Auth Status Response (initialized flag, known console)"; flow:established,to_client; target:src_ip; xbits:isset,aipt.artex.console,track ip_pair; http.stat_code; content:"200"; http.response_body; content:"|22|initialized|22|"; fast_pattern; pcre:"/^\{\s*\x22initialized\x22\s*:\s*(?:true|false)\s*\}\s*$/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500051; rev:5; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Moderate, policy alert, signature_severity Minor, tag ai_pentest, updated_at 2026_10_12;)
# source: server/auth.go:129 (401 body with the Chinese "unauthorized" error; other Chinese-language APIs can return the same JSON)
alert http $HOME_NET any -> any any (msg:"AIPT ARTEX Control Plane 401 Error Body"; flow:established,to_client; target:src_ip; http.stat_code; content:"401"; http.response_body; content:"|7b 22 65 72 72 6f 72 22 3a 22 e6 9c aa e6 8e 88 e6 9d 83 22 7d|"; startswith; fast_pattern; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500052; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence Low, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy alert, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;)
# source: web/src/config/app-config.ts:10 (HTML title; CJK substring only, the dash is rendered differently; 9500054 merged here)
alert http $HOME_NET any -> any any (msg:"AIPT ARTEX Web Console HTML Title"; flow:established,to_client; target:src_ip; http.stat_code; content:"200"; http.response_body; content:"<title>ARTEX |e2 80 94 20 e8 87 aa e4 b8 bb e6 b8 97 e9 80 8f e6 b5 8b e8 af 95 e6 8e a7 e5 88 b6 e5 8f b0|</title>"; fast_pattern; xbits:set,aipt.artex.console,track ip_pair,expire 3600; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500053; rev:5; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: server/auth.go:112 (session cookie name set by the console)
alert http any any -> $HOME_NET any (msg:"AIPT ARTEX Console Session Cookie (artex_token)"; flow:established,to_server; target:dest_ip; http.cookie; content:"artex_token="; fast_pattern; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500055; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: server/auth.go:86-93 (single hard-coded account; HS256 JWT payload always starts with {"sub":"ARTEX",)
alert http any any -> $HOME_NET any (msg:"AIPT ARTEX Console JWT With Subject ARTEX"; flow:established,to_server; target:dest_ip; http.header; content:"Authorization|3a 20|Bearer eyJ"; content:".eyJzdWIiOiJBUlRFWCIs"; fast_pattern; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500056; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: server/server.go:656, server/auth.go:173 (POST /api/auth/init with a password body); chained to 9500050/9500051/9500053
alert http any any -> $HOME_NET any (msg:"AIPT ARTEX Console First-Run Initialisation (POST /api/auth/init)"; flow:established,to_server; target:dest_ip; xbits:isset,aipt.artex.console,track ip_pair; http.method; content:"POST"; http.uri; content:"/api/auth/init"; bsize:14; fast_pattern; http.request_body; content:"|22|password|22|"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500057; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy alert, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: server/auth.go:261-275, web/src/app/(auth)/login/page.tsx:71 (login always sends username ARTEX); split from 9500057, chained like it
alert http any any -> $HOME_NET any (msg:"AIPT ARTEX Console Login With Fixed Username ARTEX"; flow:established,to_server; target:dest_ip; xbits:isset,aipt.artex.console,track ip_pair; http.method; content:"POST"; http.uri; content:"/api/auth/login"; bsize:15; http.request_body; content:"|22|ARTEX|22|"; fast_pattern; pcre:"/\x22username\x22\s*:\s*\x22ARTEX\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500061; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_10, deployment Datacenter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: server/server.go:655-933 (ARTEX-only API routes); chained so that scanner templates against other servers do not alert
alert http any any -> $HOME_NET any (msg:"AIPT ARTEX Console API Use (exploration, intercept, sync routes)"; flow:established,to_server; target:dest_ip; xbits:isset,aipt.artex.console,track ip_pair; http.uri; content:"/api/"; startswith; pcre:"/^\/api\/(?:exploration\/(?:activity|frontier|intents|graph|findings)|intercept\/(?:pending|rules|judge|history)|sync\/scopesentry|llm\/(?:profiles|pool|retry-policy)|tasks\/\d+\/(?:intents|coverage|goals))/"; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500058; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy alert, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: cmd/artex/main.go:123 (startup log line served by a log endpoint)
alert http $HOME_NET any -> any any (msg:"AIPT ARTEX Server Log Line in HTTP Response (backend listening on)"; flow:established,to_client; target:src_ip; http.response_body; content:"ARTEX "; content:"backend listening on"; fast_pattern; distance:0; within:60; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500059; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: web/src/app/favicon.ico, web/public/logo.png (MD5 list in artex-ui-assets.md5; needs response file hashing)
alert http $HOME_NET any -> any any (msg:"AIPT ARTEX Web Console Static Asset by MD5 (favicon or logo)"; flow:established,to_client; target:src_ip; filemd5:artex-ui-assets.md5; xbits:set,aipt.artex.console,track ip_pair,expire 3600; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500060; rev:4; metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)

# ---- CyberStrikeAI console (v1.7.22, edec607) ----
# source: web/templates/index.html:14 (9500102 merged here)
alert http $HOME_NET any -> any any (msg:"AIPT CyberStrikeAI Console HTML Title"; flow:established,to_client; target:src_ip; http.response_body; content:"<title>CyberStrikeAI</title>"; fast_pattern; xbits:set,aipt.csai.console,track ip_pair,expire 3600; reference:url,github.com/AIPentest/CyberStrikeAI; classtype:policy-violation; sid:9500200; rev:4; metadata:affected_product CyberStrikeAI, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: web/templates/api-docs.html:8, internal/app/app.go:1460 (/api-docs page, served without authentication)
alert http $HOME_NET any -> any any (msg:"AIPT CyberStrikeAI API Docs Page Title"; flow:established,to_client; target:src_ip; http.response_body; content:"- CyberStrikeAI</title>"; fast_pattern; xbits:set,aipt.csai.console,track ip_pair,expire 3600; reference:url,github.com/AIPentest/CyberStrikeAI; classtype:policy-violation; sid:9500201; rev:4; metadata:affected_product CyberStrikeAI, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: internal/handler/openapi.go:52, internal/app/app.go:1457 (GET /api/openapi/spec)
alert http $HOME_NET any -> any any (msg:"AIPT CyberStrikeAI OpenAPI Spec Title"; flow:established,to_client; target:src_ip; http.response_body; content:"CyberStrikeAI API"; fast_pattern; pcre:"/\x22title\x22\s*:\s*\x22CyberStrikeAI API\x22/"; xbits:set,aipt.csai.console,track ip_pair,expire 3600; reference:url,github.com/AIPentest/CyberStrikeAI; classtype:policy-violation; sid:9500202; rev:4; metadata:affected_product CyberStrikeAI, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: internal/app/app.go:1017-1044,1114-1147,1336,1360-1381,1457 (console-only API routes; paths corrected from rev 1,
# which listed /api/listeners, /api/payloads/build, /openapi/spec and /api-docs); chained to 9500200-9500202 because the
# same paths are requested by scanner templates against ordinary servers (earlier local-model CyberStrikeAI lab run). 9500203-9500205 merged here.
alert http any any -> $HOME_NET any (msg:"AIPT CyberStrikeAI Console API Use (agent, HITL, WebShell, CnC routes)"; flow:established,to_server; target:dest_ip; xbits:isset,aipt.csai.console,track ip_pair; http.uri; content:"/api/"; startswith; pcre:"/^\/api\/(?:eino-agent\/stream|multi-agent\/stream|agent-loop\/|hitl\/|tool-guard|external-mcp|webshell\/|c2\/listeners|c2\/payloads\/build|openapi\/spec)/"; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/AIPentest/CyberStrikeAI; classtype:policy-violation; sid:9500103; rev:4; metadata:affected_product CyberStrikeAI, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy alert, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: config.example.yaml:428, internal/config/config.go:1853 (HTTP MCP server auth header; server off by default)
alert http any any -> $HOME_NET any (msg:"AIPT CyberStrikeAI MCP Server Auth Header (X-MCP-Token)"; flow:established,to_server; target:dest_ip; http.header_names; content:"|0d 0a|X-MCP-Token|0d 0a|"; fast_pattern; nocase; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/AIPentest/CyberStrikeAI; classtype:policy-violation; sid:9500208; rev:4; metadata:affected_product CyberStrikeAI, attack_target Web_Server, confidence Medium, created_at 2026_10_09, deployment Internal, performance_impact Low, policy alert, signature_severity Minor, tag ai_pentest, updated_at 2026_10_12;)

# ---- HexStrike-AI API server (v6.0, d689933; Flask, 0.0.0.0:8888, no authentication) ----
# source: hexstrike_server.py:9023,9123,17289 (/health body)
alert http $HOME_NET any -> any any (msg:"AIPT HexStrike-AI API Server Health Response"; flow:established,to_client; target:src_ip; http.response_body; content:"HexStrike AI Tools API Server"; fast_pattern; reference:url,github.com/0x4m4/hexstrike-ai; classtype:policy-violation; sid:9500220; rev:4; metadata:affected_product HexStrike_AI, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: hexstrike_server.py:98,9137-9226 (command, file and payload primitives on the default port)
alert http any any -> $HOME_NET 8888 (msg:"AIPT HexStrike-AI Command or File API Request (8888)"; flow:established,to_server; target:dest_ip; http.uri; content:"/api/"; startswith; pcre:"/^\/api\/(?:command$|files\/(?:create|modify|delete|list)|payloads\/generate)/"; reference:url,github.com/0x4m4/hexstrike-ai; classtype:web-application-attack; sid:9500221; rev:4; metadata:affected_product HexStrike_AI, attack_target Web_Server, confidence Medium, created_at 2026_10_09, deployment Internal, performance_impact Low, policy alert, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: hexstrike_server.py:10327, hexstrike_mcp.py:143 (MCP client calling per-tool wrappers)
alert http any any -> $HOME_NET 8888 (msg:"AIPT HexStrike-AI Tool Wrapper API Request (8888)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.uri; content:"/api/tools/"; startswith; fast_pattern; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/0x4m4/hexstrike-ai; classtype:attempted-recon; sid:9500222; rev:4; metadata:affected_product HexStrike_AI, attack_target Web_Server, confidence Low, created_at 2026_10_09, deployment Internal, performance_impact Low, policy alert, signature_severity Minor, tag ai_pentest, updated_at 2026_10_12;)
# source: hexstrike_mcp.py:277 (FastMCP server name). hexstrike_mcp.py:5462 starts the server with mcp.run() without arguments, i.e.
# stdio only: the string never crosses the network unless the transport was changed to HTTP/SSE, hence alert, not block-eligible
alert http any any -> any any (msg:"AIPT HexStrike-AI MCP Server Name in JSON-RPC Response"; flow:established,to_client; target:src_ip; http.response_body; content:"hexstrike-ai-mcp"; fast_pattern; content:"jsonrpc"; reference:url,github.com/0x4m4/hexstrike-ai; classtype:policy-violation; sid:9500225; rev:5; metadata:affected_product HexStrike_AI, attack_target Client_Endpoint, confidence High, created_at 2026_10_09, deployment Internal, performance_impact Low, policy alert, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)

# ---- PentAGI UI (b611fbe; HTTPS 8443, loopback by default: visible on exposed or TLS-terminated instances) ----
# source: frontend/index.html:20
alert http $HOME_NET any -> any any (msg:"AIPT PentAGI Web UI HTML Title"; flow:established,to_client; target:src_ip; http.response_body; content:"<title>PentAGI</title>"; fast_pattern; reference:url,github.com/vxcontrol/pentagi; classtype:policy-violation; sid:9500231; rev:4; metadata:affected_product PentAGI, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)

# ---- MetasploitMCP (afc792d) ----
# source: MetasploitMCP.py:29-31, README.md:69 (README starts msfrpcd with -S, i.e. plaintext RPC, and -a 127.0.0.1: the default setup is
# loopback-only and invisible to a network sensor; this rule applies to remote msfrpcd setups); any msfrpcd client looks the same
alert http any any -> $HOME_NET 55553 (msg:"AIPT MetasploitMCP msfrpcd RPC Over Plaintext HTTP (55553)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.uri; content:"/api/"; startswith; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/GH05TCREW/MetasploitMCP; classtype:policy-violation; sid:9500265; rev:5; metadata:affected_product MetasploitMCP, attack_target Client_Endpoint, confidence Low, created_at 2026_10_09, deployment Internal, performance_impact Low, policy alert, signature_severity Minor, tag ai_pentest, updated_at 2026_10_12;)
# source: MetasploitMCP.py:28, README.md:69 (default MSF_PASSWORD literal in the RPC login; README default -a 127.0.0.1, so remote msfrpcd setups only)
alert http any any -> $HOME_NET 55553 (msg:"AIPT MetasploitMCP Default msfrpcd Password in RPC Login"; flow:established,to_server; target:dest_ip; http.request_body; content:"yourpassword"; fast_pattern; reference:url,github.com/GH05TCREW/MetasploitMCP; classtype:policy-violation; sid:9500266; rev:5; metadata:affected_product MetasploitMCP, attack_target Client_Endpoint, confidence High, created_at 2026_10_09, deployment Internal, performance_impact Low, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: MetasploitMCP.py:1643,1666-1667,1725,1758, README.md:91 (SSE transport GET /sse, POST /messages/ on 8085). --host defaults to
# 127.0.0.1 (MetasploitMCP.py:1725); only instances started with --host 0.0.0.0 (the README example) or reverse-proxied are visible
alert http any any -> $HOME_NET 8085 (msg:"AIPT MetasploitMCP MCP SSE Endpoint Request (8085)"; flow:established,to_server; target:dest_ip; http.uri; pcre:"/^\/(?:sse$|messages\/)/"; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/GH05TCREW/MetasploitMCP; classtype:policy-violation; sid:9500267; rev:5; metadata:affected_product MetasploitMCP, attack_target Client_Endpoint, confidence Low, created_at 2026_10_09, deployment Internal, performance_impact Low, policy informational, signature_severity Minor, tag ai_pentest, updated_at 2026_10_12;)
# source: MetasploitMCP.py:830,992,1083,1235,1473 (MCP tools/call naming a Metasploit tool function)
alert http any any -> any any (msg:"AIPT MetasploitMCP MCP tools/call of a Metasploit Tool"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"tools/call"; fast_pattern; pcre:"/\x22(?:run_exploit|run_post_module|run_auxiliary_module|generate_payload|send_session_command|start_listener|terminate_session)\x22/"; reference:url,github.com/GH05TCREW/MetasploitMCP; classtype:web-application-attack; sid:9500268; rev:4; metadata:affected_product MetasploitMCP, attack_target Client_Endpoint, confidence High, created_at 2026_10_09, deployment Internal, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)

# ---- Generic MCP over HTTP (any MCP server or client; ports 80/443 excluded to keep sanctioned SaaS MCP out) ----
# source: MCP JSON-RPC method tools/call (similar-tools.md 7 A.3)
alert http any any -> any ![80,443] (msg:"AIPT Generic MCP JSON-RPC tools/call Over HTTP (non-standard port)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"tools/call"; fast_pattern; content:"jsonrpc"; pcre:"/\x22method\x22\s*:\s*\x22tools\/call\x22/"; threshold:type limit, track by_src, count 1, seconds 600; classtype:policy-violation; sid:9500280; rev:4; metadata:affected_product Any, attack_target Client_Endpoint, confidence Low, created_at 2026_10_09, deployment Internal, performance_impact Moderate, policy informational, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;)
# source: MCP JSON-RPC method tools/list (similar-tools.md 7 A.3); earlier local-model CyberStrikeAI lab run: a scanner template probing a web target for MCP
