# ---- retired in 1.0.0 (2026-10-12) ----
# sid 9500232 removed - PentAGI publishes 8443 on 127.0.0.1 by default (docker-compose.yml:33), so a network sensor sees nothing unless the instance is exposed, and /api/v1/graphql is a generic GraphQL layout that matched an internal service on 8443 (measured); ModSecurity 9590222 and Sigma web_pentagi_graphql_api_request removed with it (was in aipt-exposed-console.rules)
# alert http any any -> $HOME_NET 8443 (msg:"AIPT PentAGI GraphQL API Request (8443)"; flow:established,to_server; target:dest_ip; http.uri; content:"/api/v1/graphql"; startswith; fast_pattern; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/vxcontrol/pentagi; classtype:policy-violation; sid:9500232; rev:4; metadata:affected_product PentAGI, attack_target Web_Server, confidence Low, created_at 2026_10_09, deployment Datacenter, performance_impact Low, policy informational, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;)
# sid 9500243 removed - the Caido sidecar listens inside the Strix sandbox container (strix/runtime/session_manager.py:33-34) and is not reachable by a network sensor; POST /graphql on 48080 matched other GraphQL services (measured); Sigma net_connection_lnx_strix_caido_sidecar removed with it (was in aipt-exposed-console.rules)
# alert http any any -> $HOME_NET 48080 (msg:"AIPT Strix Caido Sidecar GraphQL Request (48080)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.uri; content:"/graphql"; startswith; fast_pattern; threshold:type limit, track by_src, count 1, seconds 600; reference:url,github.com/usestrix/strix; classtype:policy-violation; sid:9500243; rev:4; metadata:affected_product Strix, attack_target Client_Endpoint, confidence Low, created_at 2026_10_09, deployment Internal, performance_impact Low, policy informational, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;)
