# AIPT - detection pack for LLM-driven autonomous pentest tools
# File:       aipt-llm-side.rules - LLM side: tool-function sets and short markers in LLM API bodies (cleartext legs only)
# Version:    1.0.0 (2026-10-12)
# License:    Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
# Engine:     Suricata 7.0 / 8.0 (validated with suricata -T and offline -r replay on 8.0.7)
# Message:    "AIPT <tool> <what>"; generic shapes use <tool> = Generic or Scanner.
# Metadata:   affected_product, attack_target, confidence, created_at, deployment, performance_impact, policy,
#             signature_severity, tag ai_pentest,
#             updated_at (Emerging Threats Open layout). Each rule is preceded by one comment line with its source
#             (upstream file:line at the commit in README.md, or the lab capture that established it).
# Policy:     metadata "policy block-eligible|alert|informational" (measured false-positive profile in
#             docs/fp-report.md). Every action stays alert. Only block-eligible sids (listed in
#             suricata/aipt-block-eligible.sids) are candidates for drop, per sensor, after the observe-mode baseline
#             and review of DEPLOYMENT.md.
# SID ranges: 9500001-9500099 ARTEX, 9500100-9500199 earlier comparison rules, 9500200-9500299 AI-pentest family
#             (CyberStrikeAI 9500200-9500219, HexStrike-AI 9500220-9500229, PentAGI 9500230-9500239, Strix 9500240-9500249,
#             Shannon 9500250-9500259, Villager 9500260-9500264, MetasploitMCP 9500265-9500279, generic MCP 9500280-9500289,
#             scanner shapes 9500290-9500299). Retired sids are listed in retired.rules and never reused.
# Deployment (one file per sensor position; load only what the sensor can see):
#   aipt-target-facing.rules    IDS in front of your own web servers (perimeter or reverse-proxy mirror): tool and
#                               scanner fingerprints in requests sent to your applications.
#   aipt-exposed-console.rules  datacenter / hosting / internal sensors that may see an operator console or tool API
#                               (ARTEX, CyberStrikeAI, HexStrike-AI, PentAGI, MetasploitMCP, MCP servers).
#   aipt-operator-egress.rules  egress sensors of networks where an operator could run one of these tools (update
#                               checks, vendor APIs, image pulls). Most of these services are HTTPS-only: the http
#                               rules need a TLS-inspecting proxy, the tls rules use SNI/certificates.
#   aipt-llm-side.rules         only where LLM API traffic is cleartext: TLS-terminating egress proxy, LLM relay or
#                               gateway, the provider, or a local model server (Ollama/vLLM). Needs large request
#                               body limits (see that file).
#   threshold.config: approved-assessment-suppress.threshold.template (generic sids only).
#
# These rules inspect LLM API request/response bodies. They ONLY apply where that traffic is cleartext: a TLS-
# terminating egress proxy, an LLM relay/gateway, the provider itself, or a local model server (Ollama, vLLM). Against
# a hosted provider without TLS termination they never fire. The tools array sits at the END of large OpenAI-format
# bodies: raise app-layer.protocols.http.libhtp.default-config.request-body-limit / response-body-limit and
# stream.reassembly.depth (the validation harness uses 10mb for all three).
# Indicators are tool-function names and short fixed markers only; no prompt text beyond a few words is carried.

# ---- ARTEX (tool names: agent/tools.go:2033-2054, agent/tools_insert.go:644-681) ----
# source: agent/tools.go:2033 (planner tool set)
alert http any any -> any any (msg:"AIPT ARTEX Planner LLM Request (graph_overview, add_intent, prove_goal tools)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"|22|graph_overview|22|"; fast_pattern; content:"|22|add_intent|22|"; content:"|22|prove_goal|22|"; pcre:"/\x22name\x22\s*:\s*\x22graph_overview\x22/"; pcre:"/\x22name\x22\s*:\s*\x22add_intent\x22/"; pcre:"/\x22name\x22\s*:\s*\x22prove_goal\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500023; rev:5; metadata:affected_product ARTEX, attack_target LLM_Provider, confidence High, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: agent/tools_insert.go:644-681 (worker tool set); names at agent/tools.go:1354 (record_fact), agent/tools.go:1220 (report_finding), agent/tools_insert.go:124 (insert_assets)
alert http any any -> any any (msg:"AIPT ARTEX Worker LLM Request (record_fact, report_finding, insert_assets tools)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"|22|record_fact|22|"; fast_pattern; content:"|22|report_finding|22|"; content:"|22|insert_assets|22|"; pcre:"/\x22name\x22\s*:\s*\x22record_fact\x22/"; pcre:"/\x22name\x22\s*:\s*\x22report_finding\x22/"; pcre:"/\x22name\x22\s*:\s*\x22insert_assets\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500024; rev:6; metadata:affected_product ARTEX, attack_target LLM_Provider, confidence High, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: traffic/traffic.go:2007-2062 (traffic_search, traffic_get, traffic_blob tool definitions, present when traffic capture is on)
alert http any any -> any any (msg:"AIPT ARTEX LLM Request With Traffic Recorder Tools (traffic_search, traffic_get, traffic_blob)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"|22|traffic_search|22|"; fast_pattern; content:"|22|traffic_get|22|"; content:"|22|traffic_blob|22|"; pcre:"/\x22name\x22\s*:\s*\x22traffic_search\x22/"; pcre:"/\x22name\x22\s*:\s*\x22traffic_get\x22/"; pcre:"/\x22name\x22\s*:\s*\x22traffic_blob\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500025; rev:6; metadata:affected_product ARTEX, attack_target LLM_Provider, confidence High, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
