alert http any any -> any any (msg:"AIPT ARTEX Norma SDK Agent LLM Request (SearchExtraTools, ExecuteExtraTool)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"|22|SearchExtraTools|22|"; fast_pattern; content:"|22|ExecuteExtraTool|22|"; pcre:"/\x22name\x22\s*:\s*\x22SearchExtraTools\x22/"; pcre:"/\x22name\x22\s*:\s*\x22ExecuteExtraTool\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500035; rev:5; metadata:affected_product ARTEX, attack_target LLM_Provider, confidence Medium, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy alert, signature_severity Minor, tag ai_pentest, updated_at 2026_10_12;)
# source: agent/tools.go:1092 (add_intent), agent/tools.go:1158 (prove_goal), agent/tools_insert.go:124 (insert_assets): OpenAI-format tool_calls
# naming an ARTEX-only tool. rev 5: set_goals, report_finding and record_fact dropped (names other agents also use); a response usually
# carries one call, so one name is enough and the tier is alert, not block-eligible
alert http any any -> any any (msg:"AIPT ARTEX Tool Call in LLM Response (OpenAI tool_calls)"; flow:established,to_client; target:src_ip; http.response_body; content:"tool_calls"; fast_pattern; pcre:"/\x22name\x22\s*:\s*\x22(?:add_intent|prove_goal|insert_assets)\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500036; rev:5; metadata:affected_product ARTEX, attack_target LLM_Provider, confidence High, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy alert, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: the same three names in the Anthropic Messages response shape (content block with "type":"tool_use"); Gemini functionCall is not covered
alert http any any -> any any (msg:"AIPT ARTEX Tool Call in LLM Response (Anthropic tool_use)"; flow:established,to_client; target:src_ip; http.response_body; content:"|22|tool_use|22|"; fast_pattern; pcre:"/\x22type\x22\s*:\s*\x22tool_use\x22/"; pcre:"/\x22name\x22\s*:\s*\x22(?:add_intent|prove_goal|insert_assets)\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500047; rev:1; metadata:affected_product ARTEX, attack_target LLM_Provider, confidence High, created_at 2026_10_12, deployment Perimeter, performance_impact Moderate, policy alert, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: norma/llm/provider.go:184-195; lab runs 01-03 (ARTEX and CyberStrikeAI both post with the Go default UA)
# false-positive profile (docs/fp-report.md): limited to one alert per client per 10 minutes (internal LLM applications use function calling)
alert http any any -> any any (msg:"AIPT Generic Go LLM Agent chat/completions Request With Function Tools"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.uri; content:"/chat/completions"; endswith; http.user_agent; content:"Go-http-client/"; startswith; http.request_body; content:"|22|function|22|"; fast_pattern; pcre:"/\x22type\x22\s*:\s*\x22function\x22/"; threshold:type limit, track by_src, count 1, seconds 600; classtype:policy-violation; sid:9500037; rev:5; metadata:affected_product Any, attack_target LLM_Provider, confidence Low, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy informational, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;)

# ---- AI-pentest family ----
# source: CyberStrikeAI internal/multiagent/hitl_toolsearch_compat.go:9, internal/mcp/builtin/constants.go:7-50 (9500104/9500105/9500210 merged here)
# rev 5: tool_search plus two distinct CyberStrikeAI-only names (webshell_exec, manage_webshell_list, complete_asset_scan, record_vulnerability);
# the generic names search_knowledge_base, upsert_project_fact and wait_tool_execution were dropped (other agents use them)
alert http any any -> any any (msg:"AIPT CyberStrikeAI LLM Request (tool_search with built-in tool set)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"tool_search"; fast_pattern; pcre:"/\x22(webshell_exec|manage_webshell_list|complete_asset_scan|record_vulnerability)\x22[\s\S]*?\x22(?!\1\x22)(?:webshell_exec|manage_webshell_list|complete_asset_scan|record_vulnerability)\x22/"; reference:url,github.com/AIPentest/CyberStrikeAI; classtype:policy-violation; sid:9500209; rev:5; metadata:affected_product CyberStrikeAI, attack_target LLM_Provider, confidence High, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
# source: HexStrike-AI hexstrike_mcp.py:284,327,371,3969 (MCP tool functions exposed to the model)
