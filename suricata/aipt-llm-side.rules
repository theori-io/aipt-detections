alert http any any -> any any (msg:"AIPT ARTEX Goals Decomposer LLM Request (set_goals, set_constraints, add_task_scope tools)"; flow:established,to_server; target:dest_ip; http.method; content:"POST"; http.request_body; content:"|22|set_goals|22|"; fast_pattern; content:"|22|set_constraints|22|"; content:"|22|add_task_scope|22|"; pcre:"/\x22name\x22\s*:\s*\x22set_goals\x22/"; pcre:"/\x22name\x22\s*:\s*\x22set_constraints\x22/"; pcre:"/\x22name\x22\s*:\s*\x22add_task_scope\x22/"; reference:url,github.com/Autumn-27/ARTEX; classtype:policy-violation; sid:9500026; rev:6; metadata:affected_product ARTEX, attack_target LLM_Provider, confidence High, created_at 2026_10_09, deployment Perimeter, performance_impact Moderate, policy block-eligible, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;)
